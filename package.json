{
  "name": "jarvis-workspace",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.19.0 <23",
    "pnpm": ">=11 <12"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22.23.3",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "pnpm --filter @jarvis/desktop dev",
    "build": "turbo run build",
    "start": "pnpm --filter @jarvis/desktop start",
    "typecheck": "turbo run typecheck",
    "lint": "biome lint . --error-on-warnings",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "node scripts/check-tokens.mjs && biome check . --error-on-warnings && pnpm typecheck",
    "test:smoke": "pnpm build && pnpm --filter @jarvis/desktop test:smoke",
    "package:dir": "pnpm build && pnpm --filter @jarvis/desktop package:dir"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "turbo": "2.11.9",
    "typescript": "5.9.3"
  }
}
